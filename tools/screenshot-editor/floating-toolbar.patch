diff --git a/res/style/swappy.css b/res/style/swappy.css
index 66013b3..eb82f2f 100644
--- a/res/style/swappy.css
+++ b/res/style/swappy.css
@@ -1,6 +1,49 @@
-.drawing .text-button {
+/* One floating bar over the image. Dark and self-contained, so it reads the
+   same whatever GTK theme is in use and never inherits a light panel. */
+.floating-toolbar {
+  background-color: rgba(20, 20, 26, 0.94);
+  border: 1px solid rgba(255, 255, 255, 0.10);
+  border-radius: 12px;
+  padding: 5px 7px;
+}
+
+.floating-toolbar button {
+  min-width: 28px;
+  min-height: 26px;
+  padding: 1px 6px;
+  margin: 0;
+  border: none;
+  border-radius: 8px;
+  background-image: none;
+  background-color: transparent;
+  box-shadow: none;
+  color: #d8d8e0;
+  text-shadow: none;
+}
+
+.floating-toolbar button:hover {
+  background-color: rgba(255, 255, 255, 0.10);
+  color: #ffffff;
+}
+
+.floating-toolbar button:checked {
+  background-color: rgba(255, 255, 255, 0.18);
+  color: #ffffff;
+}
+
+.floating-toolbar button:disabled {
+  color: rgba(216, 216, 224, 0.35);
+}
+
+.floating-toolbar separator {
+  background-color: rgba(255, 255, 255, 0.12);
+  min-width: 1px;
+}
+
+.drawing .text-button,
+.floating-toolbar .text-button {
   font-family: "FontAwesome 5 Free Solid", "FontAwesome";
-  padding: 4px;
+  font-size: 13px;
 }
 
 .drawing .text-button radio,
@@ -8,22 +51,47 @@
   padding: 0;
 }
 
+/* Colours are dots rather than buttons: less chrome, and the selected one is
+   obvious from the ring the :checked background draws around it. */
 .color-box button {
-  padding: 6px 10px;
+  padding: 4px;
+  min-width: 24px;
 }
 
 .color-box image {
-  border-radius: 50px;
+  min-width: 14px;
+  min-height: 14px;
+  border-radius: 50%;
+  border: 1px solid rgba(0, 0, 0, 0.35);
 }
 
 .color-box .color-red image {
-  background-color: rgb(255, 0, 0);
+  background-color: rgb(235, 77, 75);
 }
 
 .color-box .color-green image {
-  background-color: rgb(0, 255, 0);
+  background-color: rgb(106, 176, 76);
 }
 
 .color-box .color-blue image {
-  background-color: rgb(0, 0, 255);
+  background-color: rgb(34, 166, 179);
+}
+
+.color-box .color-custom image {
+  background-image: linear-gradient(135deg, #f0932b, #eb4d4b, #22a6b3);
+}
+
+/* The colour picker is one more dot, not a slab of colour. */
+.floating-toolbar button.color {
+  padding: 4px;
+  min-width: 24px;
+}
+
+.floating-toolbar button.color colorswatch,
+.floating-toolbar button.color colorswatch > * {
+  border-radius: 50%;
+  min-width: 16px;
+  min-height: 16px;
+  padding: 0;
+  margin: 0;
 }
