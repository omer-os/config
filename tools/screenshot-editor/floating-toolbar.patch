diff --git a/include/text.h b/include/text.h
new file mode 100644
index 0000000..ae376bb
--- /dev/null
+++ b/include/text.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <pango/pangocairo.h>
+
+#include "swappy.h"
+
+/* Text measurement and caret arithmetic, shared by the renderer (which draws
+   the run and its caret) and the paint layer (which moves the caret and
+   decides what a click landed on). Both ask the same Pango layout, so what
+   you see is what the keys act on.
+   Positions are image coordinates; offsets are character counts, matching
+   what swappy_paint_text stores -- Pango's byte indices stay inside here. */
+
+/* Caller owns the layout: g_object_unref it. */
+PangoLayout *text_layout_new(const struct swappy_paint_text *text);
+
+gboolean text_is_empty(const struct swappy_paint_text *text);
+
+/* Bounding box of the run, anchored at text->from. Never zero-width, so an
+   empty run still has something to hit and something to outline. */
+void text_extents(const struct swappy_paint_text *text,
+                  struct swappy_box *box);
+
+/* Caret rectangle for the run's current cursor offset. */
+void text_cursor_extents(const struct swappy_paint_text *text,
+                         struct swappy_box *box);
+
+gboolean text_hit(const struct swappy_paint_text *text, double x, double y);
+
+/* Character offset nearest the point -- where a click puts the caret. */
+glong text_offset_at(const struct swappy_paint_text *text, double x, double y);
+
+/* Caret motions. `dir` is -1 for backwards, 1 for forwards. Each clamps to
+   the ends of the run rather than wrapping or refusing to move. */
+glong text_offset_by_char(const struct swappy_paint_text *text, glong cursor,
+                          int dir);
+glong text_offset_by_word(const struct swappy_paint_text *text, glong cursor,
+                          int dir);
+glong text_offset_by_line(const struct swappy_paint_text *text, glong cursor,
+                          int dir);
+glong text_offset_line_edge(const struct swappy_paint_text *text, glong cursor,
+                            int dir);
