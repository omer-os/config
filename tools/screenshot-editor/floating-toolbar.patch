@@ -0,0 +1,235 @@
+#include "text.h"
+
+#include <string.h>
+
+/* One PangoContext for the whole program. It comes from the cairo font map,
+   so a layout built here can be handed straight to pango_cairo_show_layout:
+   the run is measured and drawn by the same object, which is the only way
+   the caret lands exactly where the glyphs do. */
+static PangoContext *text_context(void) {
+  static PangoContext *context = NULL;
+
+  if (context == NULL) {
+    context = pango_font_map_create_context(pango_cairo_font_map_get_default());
+  }
+
+  return context;
+}
+
+static const gchar *text_str(const struct swappy_paint_text *text) {
+  return text->text ? text->text : "";
+}
+
+static glong text_length(const struct swappy_paint_text *text) {
+  return g_utf8_strlen(text_str(text), -1);
+}
+
+static glong clamp_offset(const struct swappy_paint_text *text, glong offset) {
+  glong len = text_length(text);
+
+  if (offset < 0) return 0;
+  if (offset > len) return len;
+  return offset;
+}
+
+static int offset_to_index(const struct swappy_paint_text *text,
+                           glong offset) {
+  const gchar *str = text_str(text);
+  return (int)(g_utf8_offset_to_pointer(str, clamp_offset(text, offset)) - str);
+}
+
+static glong index_to_offset(const struct swappy_paint_text *text, int index) {
+  const gchar *str = text_str(text);
+  glong bytes = (glong)strlen(str);
+
+  if (index < 0) index = 0;
+  if (index > bytes) index = bytes;
+
+  return g_utf8_pointer_to_offset(str, str + index);
+}
+
+PangoLayout *text_layout_new(const struct swappy_paint_text *text) {
+  char font[256];
+  PangoLayout *layout = pango_layout_new(text_context());
+  PangoFontDescription *desc;
+
+  /* No width is set on purpose: the run grows with what is typed and wraps
+     only where there is a newline. Upstream wrapped into the box the mouse
+     had dragged out and clipped whatever did not fit, so text could vanish
+     as it was typed. */
+  pango_layout_set_text(layout, text_str(text), -1);
+
+  g_snprintf(font, sizeof(font), "%s %d", text->font ? text->font : "Sans",
+             (int)text->s);
+  desc = pango_font_description_from_string(font);
+  pango_layout_set_font_description(layout, desc);
+  pango_font_description_free(desc);
+
+  return layout;
+}
+
+gboolean text_is_empty(const struct swappy_paint_text *text) {
+  return text_length(text) == 0;
+}
+
+void text_extents(const struct swappy_paint_text *text,
+                  struct swappy_box *box) {
+  PangoLayout *layout = text_layout_new(text);
+  PangoRectangle logical;
+
+  pango_layout_get_pixel_extents(layout, NULL, &logical);
+
+  box->x = text->from.x + logical.x;
+  box->y = text->from.y + logical.y;
+  box->width = MAX(logical.width, 2);
+  box->height = MAX(logical.height, 2);
+
+  g_object_unref(layout);
+}
+
+void text_cursor_extents(const struct swappy_paint_text *text,
+                         struct swappy_box *box) {
+  PangoLayout *layout = text_layout_new(text);
+  PangoRectangle strong;
+
+  pango_layout_get_cursor_pos(layout, offset_to_index(text, text->cursor),
+                              &strong, NULL);
+
+  box->x = text->from.x + pango_units_to_double(strong.x);
+  box->y = text->from.y + pango_units_to_double(strong.y);
+  box->width = 2;
+  box->height = MAX(pango_units_to_double(strong.height), 2);
+
+  g_object_unref(layout);
+}
+
+gboolean text_hit(const struct swappy_paint_text *text, double x, double y) {
+  /* A few pixels of slack around the run: annotation text is often small,
+     and asking for a pixel-perfect click on a thin glyph row is the kind of
+     thing that makes a tool feel broken. */
+  const int slack = 6;
+  struct swappy_box box;
+
+  text_extents(text, &box);
+
+  return x >= box.x - slack && x <= box.x + box.width + slack &&
+         y >= box.y - slack && y <= box.y + box.height + slack;
+}
+
+glong text_offset_at(const struct swappy_paint_text *text, double x,
+                     double y) {
+  PangoLayout *layout = text_layout_new(text);
+  int index = 0;
+  int trailing = 0;
+  glong offset;
+
+  /* Returns FALSE for a point outside the run but still fills in the nearest
+     position, which is exactly what clicking past the end of a line should
+     do. */
+  pango_layout_xy_to_index(layout, pango_units_from_double(x - text->from.x),
+                           pango_units_from_double(y - text->from.y), &index,
+                           &trailing);
+
+  offset = index_to_offset(text, index) + trailing;
+
+  g_object_unref(layout);
+
+  return clamp_offset(text, offset);
+}
+
+glong text_offset_by_char(const struct swappy_paint_text *text, glong cursor,
+                          int dir) {
+  return clamp_offset(text, cursor + (dir < 0 ? -1 : 1));
+}
+
+glong text_offset_by_word(const struct swappy_paint_text *text, glong cursor,
+                          int dir) {
+  PangoLayout *layout = text_layout_new(text);
+  const PangoLogAttr *attrs;
+  gint n_attrs = 0;
+  glong len = text_length(text);
+  glong i = clamp_offset(text, cursor);
+
+  /* One attribute per character plus one past the end, so the array indexes
+     by the same character offsets the cursor uses. */
+  attrs = pango_layout_get_log_attrs_readonly(layout, &n_attrs);
+
+  /* Backwards lands on the start of a word, forwards on the end of one --
+     the same asymmetry every text field has, and the reason Ctrl+Backspace
+     takes the word plus the space in front of it rather than the space
+     alone. */
+  if (dir < 0) {
+    for (i--; i > 0; i--) {
+      if (i < n_attrs && attrs[i].is_word_start) {
+        break;
+      }
+    }
+  } else {
+    for (i++; i < len; i++) {
+      if (i < n_attrs && attrs[i].is_word_end) {
+        break;
+      }
+    }
+  }
+
+  g_object_unref(layout);
+
+  return clamp_offset(text, i);
+}
+
+glong text_offset_by_line(const struct swappy_paint_text *text, glong cursor,
+                          int dir) {
+  PangoLayout *layout = text_layout_new(text);
+  PangoLayoutLine *line;
+  int line_no = 0;
+  int x_pos = 0;
+  int index = 0;
+  int trailing = 0;
+  int target;
+  glong offset;
+
+  pango_layout_index_to_line_x(layout, offset_to_index(text, cursor), FALSE,
+                               &line_no, &x_pos);
+  target = line_no + (dir < 0 ? -1 : 1);
+
+  if (target < 0) {
+    offset = 0;
+  } else if (target >= pango_layout_get_line_count(layout)) {
+    offset = text_length(text);
+  } else {
+    /* Keep the horizontal position across the move, the way every text field
+       does -- the caret comes back to the same column. */
+    line = pango_layout_get_line_readonly(layout, target);
+    pango_layout_line_x_to_index(line, x_pos, &index, &trailing);
+    offset = index_to_offset(text, index) + trailing;
+  }
+
+  g_object_unref(layout);
+
+  return clamp_offset(text, offset);
+}
+
+glong text_offset_line_edge(const struct swappy_paint_text *text, glong cursor,
+                            int dir) {
+  PangoLayout *layout = text_layout_new(text);
+  PangoLayoutLine *line;
+  int line_no = 0;
+  int x_pos = 0;
+  glong offset;
+
+  pango_layout_index_to_line_x(layout, offset_to_index(text, cursor), FALSE,
+                               &line_no, &x_pos);
+  line = pango_layout_get_line_readonly(layout, line_no);
+
+  if (line == NULL) {
+    offset = dir < 0 ? 0 : text_length(text);
+  } else if (dir < 0) {
+    offset = index_to_offset(text, line->start_index);
+  } else {
+    offset = index_to_offset(text, line->start_index + line->length);
+  }
+
+  g_object_unref(layout);
+
+  return clamp_offset(text, offset);
+}
