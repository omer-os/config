# Whitelist approach: ignore everything, then allow only the configs we track.
# This guarantees browser data, tokens, caches, and session state never get
# committed by accident.

/*

# Repo meta
!/.gitignore
!/README.md

# Tracked configs
!/waybar/
!/hypr/
!/swappy/
!/swaync/
!/swayosd/
!/wlogout/
!/kitty/
!/cava/
!/btop/
!/gtk-3.0/
!/nwg-displays/
!/fish/
!/nvim/
!/zed/
!/micro/
!/lazygit/

# Local builds driven from this repo (source is cloned, only the patch and
# the build script live here)
!/tools/

# Safety nets in case any secret-bearing files appear inside tracked dirs
**/*.log
**/*history*
**/.env
**/.env.*
**/*secret*
**/*token*
**/__pycache__/
**/*.key
**/*.pem
